#!/bin/sh
# Sourced by the release scripts before the VM starts.

# Erlang distribution (used by `bin/mealplan remote`/`rpc`) must never be
# reachable from other containers: bind epmd and the distribution listener
# to loopback only. The cookie baked into the public image would otherwise
# let any peer on the Docker network run code. Override the cookie too with
# RELEASE_COOKIE in .env.
export ERL_EPMD_ADDRESS=127.0.0.1
export ELIXIR_ERL_OPTIONS="${ELIXIR_ERL_OPTIONS:-} -kernel inet_dist_use_interface {127,0,0,1}"

# Name the node by the loopback address so remote/rpc/stop can reach the
# loopback-only listener (a short name would resolve via the container hostname).
export RELEASE_DISTRIBUTION=name
export RELEASE_NODE="${RELEASE_NODE:-mealplan@127.0.0.1}"
