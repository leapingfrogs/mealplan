#!/usr/bin/env bash
# Runs ON THE NAS as root, started by scripts/deploy: takes a pre-deploy dump,
# points the TrueNAS Custom App at the new compose YAML, and waits until the app
# container runs the new image and is healthy.
#
#   sudo bash deploy-remote APP PROJECT IMAGE COMPOSE_FILE
#
# Uses only what TrueNAS ships: bash, docker, python3 (truenas_api_client, yaml).
set -euo pipefail

app=$1 project=$2 image=$3 compose=$4

log() { echo "[nas] $*"; }
fail() { echo "[nas] ERROR: $*" >&2; exit 1; }

container() {
  docker ps -q \
    --filter "label=com.docker.compose.project=$project" \
    --filter "label=com.docker.compose.service=$1"
}

# True when container $1 runs the target image: same reference, or same digest
# (Docker may record the reference differently from how compose wrote it).
runs_target() {
  local ref digests
  ref=$(docker inspect -f '{{.Config.Image}}' "$1")
  [ "$ref" = "$image" ] && return 0
  digests=$(docker image inspect -f '{{join .RepoDigests " "}}' "$(docker inspect -f '{{.Image}}' "$1")")
  [[ " $digests " == *" ${image%%:*}@${image##*@} "* ]]
}

[ "$(id -u)" = 0 ] || fail "must run as root"
[ -s "$compose" ] || fail "compose file $compose missing or empty"
python3 -c "import truenas_api_client, yaml" 2>/dev/null || fail "truenas_api_client/yaml not importable: is this TrueNAS?"

# Talks to the TrueNAS middleware through its Python client (what midclt wraps;
# passing the ~11 KB document as a midclt argument got midclt killed).
#   api state            -> RUNNING / STOPPED / ... for the app
#   api config-matches   -> exit 0 if the stored compose equals $compose
#   api update           -> replace the compose document (waits for the job)
#   api start            -> start the app (waits for the job)
api() {
  python3 - "$1" "$app" "$compose" <<'PY'
import sys
import yaml
from truenas_api_client import Client

action, app, path = sys.argv[1:4]
with Client() as c:
    if action == "state":
        print(c.call("app.query", [["name", "=", app]], {"select": ["state"]})[0]["state"])
    elif action == "config-matches":
        with open(path) as f:
            wanted = yaml.safe_load(f)
        sys.exit(0 if c.call("app.config", app) == wanted else 1)
    elif action == "update":
        with open(path) as f:
            document = f.read()
        # Pulling a new image can outlast the client's default 60 s timeout.
        c.call("app.update", app, {"custom_compose_config_string": document}, job=True, timeout=900)
    elif action == "start":
        c.call("app.start", app, job=True, timeout=900)
PY
}

state=$(api state)
app_ctr=$(container app)
current=$( [ -n "$app_ctr" ] && docker inspect -f '{{.Config.Image}}' "$app_ctr" || echo "none")
log "app:     $app (project $project, $state)"
log "running: $current"
log "target:  $image"

if api config-matches; then config_changed=false; else config_changed=true; fi
if ! $config_changed && [ -n "$app_ctr" ] && runs_target "$app_ctr" \
  && [ "$(docker inspect -f '{{.State.Health.Status}}' "$app_ctr")" = healthy ]; then
  log "already running the target image and configuration, healthy; nothing to do"
  exit 0
fi
$config_changed && log "compose configuration differs from the deployed one"

# Pre-deploy dump, so a bad migration can be undone (docs/backups.md). If the
# app was deliberately stopped (e.g. to re-own its files), there is nothing to
# dump from: take one before stopping it.
backup_ctr=$(container backup)
if [ -n "$backup_ctr" ]; then
  log "taking pre-deploy dump"
  docker exec "$backup_ctr" bash /tmp/backup.sh manual | sed 's/^/[nas]   /'
elif [ "$state" = STOPPED ]; then
  log "WARNING: app is stopped, so no pre-deploy dump is taken"
else
  fail "backup container not running ($state); refusing to deploy without a pre-deploy dump"
fi

# The Custom App stores the whole compose document; replace it and let TrueNAS
# recreate whatever changed.
log "updating TrueNAS app $app"
api update
if [ "$(api state)" = STOPPED ]; then
  log "starting $app"
  api start
fi


log "waiting for the app to run $image and report healthy"
for _ in $(seq 1 60); do
  app_ctr=$(container app)
  if [ -n "$app_ctr" ]; then
    health=$(docker inspect -f '{{if .State.Health}}{{.State.Health.Status}}{{else}}none{{end}}' "$app_ctr")
    if runs_target "$app_ctr" && [ "$health" = healthy ]; then
      log "healthy on $image"
      log "previous image was $current"
      exit 0
    fi
  fi
  sleep 5
done

log "app did not become healthy within 5 minutes; last log lines:"
[ -n "$app_ctr" ] && docker logs --tail 30 "$app_ctr" 2>&1 | sed 's/^/[nas]   /'
fail "deploy of $image failed (previous image: $current)"
