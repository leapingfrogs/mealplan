# Production environment for the mealplan container.
# Copy to .env on the NAS (chmod 600, root-owned) and fill in real values.
# Never commit the real .env.

# --- Phoenix ---------------------------------------------------------------
# Generate with: mix phx.gen.secret
SECRET_KEY_BASE=
# Public hostname served by Nginx Proxy Manager (required)
PHX_HOST=mealplan.example.com
# Port the app listens on inside the container (NPM forwards here)
PORT=4000

# --- Database --------------------------------------------------------------
# With compose.yaml nothing is needed here: compose sets DATABASE_HOST=db and
# DATABASE_PASSWORD_FILE=/run/secrets/db_password, the file the Postgres
# container also reads (MEALPLAN_ROOT/secrets/db_password). Generate it with:
#   openssl rand -base64 32 > secrets/db_password
#
# Outside compose, use discrete variables (defaults shown)...
# DATABASE_HOST=db
# DATABASE_PORT=5432
# DATABASE_NAME=mealplan
# DATABASE_USER=mealplan
# DATABASE_PASSWORD=   (or DATABASE_PASSWORD_FILE=/path/to/file)
# ...or a single URL, which takes precedence when set:
# DATABASE_URL=ecto://mealplan:PASSWORD@db:5432/mealplan
POOL_SIZE=10
# Set to true if the database is only reachable over IPv6
# ECTO_IPV6=false

# --- Email (SMTP relay, TLS required) --------------------------------------
# Port 587 uses STARTTLS, 465 uses implicit TLS. Certificates are verified.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=mealplan@example.com
SMTP_FROM_NAME=Mealplan

# --- Reverse proxy ---------------------------------------------------------
# Subnet of the Docker network shared with Nginx Proxy Manager. Forwarded
# client IP/scheme headers are only trusted from here. Find it with:
#   docker network inspect <npm-network> --format '{{(index .IPAM.Config 0).Subnet}}'
TRUSTED_PROXIES=172.20.0.0/16

# --- Release ---------------------------------------------------------------
# Erlang distribution cookie for `bin/mealplan remote`. Distribution only
# listens on loopback, but don't rely on the cookie baked into the public image.
# Generate with: openssl rand -base64 32
RELEASE_COOKIE=
