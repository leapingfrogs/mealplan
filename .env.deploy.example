# Settings for the NAS deployment recipes (just truenas-yaml, backup-now,
# deploy). Copy to .env.deploy (gitignored) and adjust. No secrets here: those
# live only on the NAS.
MEALPLAN_ROOT=/mnt/storage/Apps/mealplan
NPM_NETWORK=ix-nginx-proxy-manager_default
# SSH target for backup-now/deploy, e.g. truenas_admin@truenas-scale (tailnet)
MEALPLAN_SSH=
# Compose project TrueNAS gives the Custom App: ix-<app name>
MEALPLAN_PROJECT=ix-mealplan
