# Settings for the NAS deployment recipes (just truenas-yaml, backup-now,
# deploy, rollback). Copy to .env.deploy (gitignored) and adjust. No secrets here: those
# live only on the NAS.
MEALPLAN_ROOT=/mnt/tank/apps/mealplan
NPM_NETWORK=ix-nginx-proxy-manager_default
# SSH target for backup-now/deploy, e.g. admin@nas (a tailnet name works well)
MEALPLAN_SSH=
# TrueNAS Custom App name, and the Compose project TrueNAS runs it as (ix-<name>)
MEALPLAN_APP=mealplan
MEALPLAN_PROJECT=ix-mealplan
# Public URL, checked after a deploy
MEALPLAN_URL=https://mealplan.example.com
